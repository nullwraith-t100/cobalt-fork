local function rc(R)local rl=6291456 if R.appendfile_perf and R.appendfile_perf.super_linear then rl=2097152 end local bh="fnv1a_64"if R.getscripthash and R.getscripthash.exists and R.getscripthash.returns_sha256 then bh="getscripthash"end local dl=false if R.decompile_cost then dl=R.decompile_cost.limited==true end return{rotation_limit_bytes=rl,mem_spool_bytes=8388608,bytecode_hash=bh,decompile_limited=dl}end
local function run()local n,v=ex()local R={appendfile_perf=t1(),renamefile=t2(),getscripthash=t3(),getconnections=t4(),comm_channel=t5(),on_teleport=t6(),window_focus_released=t7(),upvalue_name=t8(),jsonencode_invalid=t9(),decompile_cost=t10()}local p={executor=n,executor_version=v,timestamp=os.time(),results=R,recommended_config=rc(R)}wr("Cobalt/probe.json",js(p))print("[Probe] Concluído. Gravado em Cobalt/probe.json")print("[Probe] Executor: "..n.." "..v)return p end
