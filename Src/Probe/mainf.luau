local function T(f)local o,r=pcall(f);if o then return{ok=true,value=r}end return{ok=false,error=tostring(r)}end
local function t1()local A={}for _,m in ipairs{1,10,40}do local d=string.rep("A",m*1048576)local s=os.clock()local o=T(function()appendfile("Cobalt/Probe/t"..m..".bin",d)end)table.insert(A,{size_mb=m,ok=o.ok,elapsed_ms=math.floor((os.clock()-s)*1000),error=o.error})end local sl=false if #A>=3 and A[2].elapsed_ms>0 then sl=A[3].elapsed_ms>A[2].elapsed_ms*4 end return{per_size=A,super_linear=sl}end
local function t2()return{renamefile_exists=typeof(renamefile)=="function",movefile_exists=typeof(movefile)=="function"}end
local function t3()local e=typeof(getscripthash)=="function"local h=false local sm=nil if e then local o=T(function()sm=getscripthash(getfenv and getfenv()or _G)end)if o.ok and typeof(sm)=="string"then h=#sm>=64 end end return{exists=e,returns_sha256=h,sample=tostring(sm)}end
local function t4()local e=typeof(getconnections)=="function"local rf=false local hk=false if e then local b=Instance.new("BindableEvent")local cf=function()end b.Event:Connect(cf)local c=T(function()return getconnections(b.Event)end)if c.ok and typeof(c.value)=="table"then for _,x in ipairs(c.value)do if typeof(x.Function)=="function"then rf=true break end end end if rf and typeof(hookfunction)=="function"then local o=T(function()local y=hookfunction(cf,function()end)return typeof(y)=="function"end)hk=o.ok and o.value==true end b:Destroy()end return{exists=e,returns_function=rf,hookable=hk}end
local function t5()local ga=typeof(getactors)=="function"local cc=typeof(create_comm_channel)=="function"local nm=false local ac=0 if ga then local o=T(function()ac=#getactors()end)ga=o.ok end if cc then local o=T(function()local id,ch=create_comm_channel()nm=(typeof(id)=="string"or typeof(id)=="number")and(typeof(ch)=="table"or(typeof(ch)=="Instance"and ch.ClassName=="BindableEvent"))end)if not o.ok then cc=false end end return{getactors=ga,create_comm_channel=cc,names_match=nm,actor_count=ac}end
local function t6()local lp=game:GetService("Players").LocalPlayer local av=false local qt=typeof(queue_on_teleport)=="function"or typeof(queueonteleport)=="function"if lp then av=typeof(lp.OnTeleport)~=nil end return{available=av,queue_on_teleport=qt}end
local function t7()local u=game:GetService("UserInputService")return{available=typeof(u.WindowFocusReleased)~=nil}end
local function t8()local e=typeof(debug.getupvalue)=="function"local rt=false if e then local n,v local o=T(function()local x=42 local function f()return x end n,v=debug.getupvalue(f,1)end)if o.ok then rt=(n~=nil and v~=nil)end end return{exists=e,returns_tuple=rt}end
local function t9()local J=game:GetService("HttpService").JSONEncode local R={}local function X(l,v)local o=T(function()return J(v)end)if o.ok then R[l]="ok"else local e=tostring(o.error):lower()if e:find("nan")or e:find("inf")or e:find("invalid")or e:find("utf")or e:find("encode")then R[l]="fail"else R[l]="corrupt"end end end X("nan",{v=0/0})X("inf",{v=1/0})X("utf8_invalid",{v="\255\254"})return{nan=R.nan or"unknown",inf=R.inf or"unknown",utf8_invalid=R.utf8_invalid or"unknown"}end
local function t10()local de=typeof(decompile)=="function"local cm=0 local lm=false if de then local tt,n=0,0 local G={}for _,s in ipairs(game:GetDescendants())do if s:IsA("ModuleScript")or s:IsA("LocalScript")then table.insert(G,s)if #G>=5 then break end end end for _,s in ipairs(G)do local st=os.clock()pcall(decompile,s)tt+=(os.clock()-st)*1000 n+=1 end if n>0 then cm=math.floor(tt/n)end lm=cm>200 end return{exists=de,avg_cost_ms=cm,limited=lm}end
local function ex()local n,v="Unknown","Unknown"if typeof(identifyexecutor)=="function"then local o=T(function()n=tostring(identifyexecutor())end)if not o.ok then n="Unknown"end end local m=n:match("(%d+%.%d+%.%d+)")if m then v=m end return n,v end
local function js(v)local o,r=pcall(function()return game:GetService("HttpService"):JSONEncode(v)end)if o then return r end return"{}"end
